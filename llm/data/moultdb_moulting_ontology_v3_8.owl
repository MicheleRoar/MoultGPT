    <moult:legacySecondaryParent rdf:resource="http://purl.org/moultdb/ontology/MoultingProcess"/>
    <moult:legacySecondaryParent rdf:resource="http://purl.org/moultdb/ontology/PreMoultProcess"/>
    <moult:precedes rdf:resource="http://purl.org/moultdb/ontology/Ecdysis"/>
    <moult:requiresContext rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</moult:requiresContext>
    <rdfs:comment>Preparatory moulting phase that precedes ecdysis and includes detachment and remodelling processes leading to shedding.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/moultdb/ontology/MoultingPhase"/>
    <skos:altLabel>pre ecdysis</skos:altLabel>
    <skos:altLabel>pre-molt</skos:altLabel>
    <skos:altLabel>pre-moult</skos:altLabel>
    <skos:altLabel>pre-moult phase</skos:altLabel>
