  <rdf:Description rdf:about="http://purl.org/moultdb/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:creator>OpenAI for Michele Leone</dcterms:creator>
    <dcterms:description>A restructured ontology for arthropod moulting knowledge, preserving the v3.2 lexical/gating layer while organizing biological entities, processes, events, observations, traits, taxonomy, and relations into a clearer domain model.</dcterms:description>
    <dcterms:title>MoultDB Moulting Ontology v3.3</dcterms:title>
    <moult:curationNote>v3.4 structural extension: added explicit molecular component branch and curated moulting toolkit terms from Campli et al. 2024 while preserving v3.3 content.</moult:curationNote>
    <owl:versionInfo>v3.3</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/moultdb/ontology/CephalicSutureLocationValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>CephalicSutureLocationDetail</rdfs:label>
    <moult:legacySecondaryParent rdf:resource="http://purl.org/moultdb/ontology/TraitValue"/>
    <rdfs:comment>Specific cephalic refinement of moulting suture location.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/moultdb/ontology/SutureLocationValue"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/moultdb/ontology/BiologicalProcess">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>BiologicalProcess</rdfs:label>
    <moult:definition>Process-level concepts describing moulting and associated transformations.</moult:definition>
    <moult:legacySecondaryParent rdf:resource="http://purl.org/moultdb/ontology/MoultingEntity"/>
    <rdfs:subClassOf rdf:resource="http://purl.org/moultdb/ontology/BiologicalDomain"/>
  </rdf:Description>
