    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>PreMoult</rdfs:label>
    <moult:definition>Preparatory phase of moulting characterised by apolysis and early exoskeletal remodelling before the shedding event.</moult:definition>
    <moult:hasGatingWeight>strong</moult:hasGatingWeight>
    <moult:hasLexicalCue>before ecdysis</moult:hasLexicalCue>
