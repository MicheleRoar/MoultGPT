    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>PostMoult</rdfs:label>
    <moult:definition>Post-ecdysial phase characterised by cuticle tanning, sclerotization, mineralisation, pigmentation, and maturation of the new exoskeleton.</moult:definition>
    <moult:hasGatingWeight>strong</moult:hasGatingWeight>
    <moult:hasLexicalCue>after ecdysis</moult:hasLexicalCue>
    <moult:hasLexicalCue>cuticle hardening</moult:hasLexicalCue>
    <moult:hasLexicalCue>post ecdysis</moult:hasLexicalCue>
    <moult:hasLexicalCue>post moult</moult:hasLexicalCue>
