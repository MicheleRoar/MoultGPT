    <moult:legacySecondaryParent rdf:resource="http://purl.org/moultdb/ontology/MoultingProcess"/>
    <moult:legacySecondaryParent rdf:resource="http://purl.org/moultdb/ontology/PostMoultProcess"/>
    <moult:requiresContext rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</moult:requiresContext>
    <rdfs:comment>Phase following ecdysis during which the new cuticle expands, hardens, and matures.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/moultdb/ontology/MoultingPhase"/>
    <skos:altLabel>post ecdysis</skos:altLabel>
    <skos:altLabel>post-ecdysis</skos:altLabel>
    <skos:altLabel>post-molt</skos:altLabel>
    <skos:altLabel>post-moult</skos:altLabel>
    <skos:altLabel>post-moult phase</skos:altLabel>
    <skos:altLabel>postecdysis</skos:altLabel>
    <skos:altLabel>postmolt</skos:altLabel>
    <skos:altLabel>postmoult</skos:altLabel>
  </rdf:Description>
