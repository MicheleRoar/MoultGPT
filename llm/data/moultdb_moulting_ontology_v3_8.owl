  <rdf:Description rdf:about="http://purl.org/moultdb/ontology/ExoskeletonRemodelling">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Exoskeleton remodelling</rdfs:label>
    <moult:definition>Composite remodelling programme spanning pre-moult to post-moult and involving detachment of the old cuticle, synthesis and organisation of the new cuticle, and its subsequent maturation.</moult:definition>
    <moult:hasGatingWeight>strong</moult:hasGatingWeight>
    <moult:hasLexicalCue>remodelling of exoskeleton</moult:hasLexicalCue>
    <moult:hasSemanticRole>process</moult:hasSemanticRole>
    <moult:legacySecondaryParent rdf:resource="http://purl.org/moultdb/ontology/MoultingProcess"/>
    <moult:occursDuringPhase rdf:resource="http://purl.org/moultdb/ontology/Ecdysis"/>
    <moult:occursDuringPhase rdf:resource="http://purl.org/moultdb/ontology/PostMoult"/>
    <moult:occursDuringPhase rdf:resource="http://purl.org/moultdb/ontology/PreMoult"/>
    <moult:requiresContext rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</moult:requiresContext>
    <rdfs:comment>Integrated process of cuticle detachment, synthesis, degradation, organisation, tanning, mineralisation and maturation during moulting.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/moultdb/ontology/BiologicalProcess"/>
    <skos:altLabel>exoskeleton remodeling</skos:altLabel>
  </rdf:Description>
