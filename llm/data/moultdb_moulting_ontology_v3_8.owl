    <moult:part_of rdf:resource="http://purl.org/moultdb/ontology/PostMoult"/>
    <moult:requiresContext rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</moult:requiresContext>
    <rdfs:comment>Hardening and cross-linking of cuticle after moulting.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="n73561207745144038b563c9c6632ce93b23"/>
    <rdfs:subClassOf rdf:nodeID="n73561207745144038b563c9c6632ce93b24"/>
    <rdfs:subClassOf rdf:resource="http://purl.org/moultdb/ontology/PostMoultProcess"/>
    <skos:altLabel>Sclerotisation</skos:altLabel>
