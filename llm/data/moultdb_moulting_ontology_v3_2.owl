  <owl:Class rdf:about="http://purl.org/moultdb/ontology/MoultingObservation">
    <rdfs:label>MoultingObservation</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.org/moultdb/ontology/Observation"/>
