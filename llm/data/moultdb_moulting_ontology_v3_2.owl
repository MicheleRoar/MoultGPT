    <rdfs:range rdf:resource="http://purl.org/moultdb/ontology/AnatomicalStructure"/>
    <rdfs:comment>Links a moulting event to an anatomical structure it produces.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://purl.org/moultdb/ontology/PreservationQualityValue">
