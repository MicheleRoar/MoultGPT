  <owl:Class rdf:about="http://purl.org/moultdb/ontology/Melanisation">
    <rdfs:label>Melanisation</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.org/moultdb/ontology/MoultingProcess"/>
