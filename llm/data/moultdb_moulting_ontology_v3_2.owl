  </owl:ObjectProperty>
  <owl:Class rdf:about="http://purl.org/moultdb/ontology/CuticleDegradation">
    <rdfs:label>CuticleDegradation</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.org/moultdb/ontology/MoultingProcess"/>
    <rdfs:subClassOf rdf:resource="http://purl.org/moultdb/ontology/PreMoultEvent"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N5ff939fc4e9f4bbd9218d1fd025b0678">
        <owl:onProperty rdf:resource="http://purl.org/moultdb/ontology/occursDuringPhase"/>
        <owl:someValuesFrom rdf:resource="http://purl.org/moultdb/ontology/PreMoult"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N16552999c4804337805b42e64c84526d">
        <owl:onProperty rdf:resource="http://purl.org/moultdb/ontology/involvesStructure"/>
        <owl:someValuesFrom rdf:resource="http://purl.org/moultdb/ontology/Cuticle"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>Degradation or reabsorption of old cuticle material.</rdfs:comment>
    <mdo:hasLexicalCue>cuticle degradation</mdo:hasLexicalCue>
    <mdo:hasLexicalCue>old cuticle digestion</mdo:hasLexicalCue>
    <mdo:hasLexicalCue>old cuticle breakdown</mdo:hasLexicalCue>
    <mdo:hasLexicalCue>old cuticle resorption</mdo:hasLexicalCue>
    <mdo:hasGatingWeight>medium</mdo:hasGatingWeight>
    <mdo:hasSemanticRole>premoult_event</mdo:hasSemanticRole>
    <mdo:requiresContext rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</mdo:requiresContext>
  </owl:Class>
  <owl:Class rdf:about="http://purl.org/moultdb/ontology/BehaviouralContext">
