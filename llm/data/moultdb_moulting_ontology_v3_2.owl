        <owl:someValuesFrom rdf:resource="http://purl.org/moultdb/ontology/Cuticle"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>Pigment deposition or melanization of cuticle.</rdfs:comment>
    <skos:altLabel>melanization</skos:altLabel>
    <skos:altLabel>Melanization</skos:altLabel>
    <skos:altLabel>Cuticle pigmentation</skos:altLabel>
    <skos:altLabel>Cuticle tanning</skos:altLabel>
    <mdo:hasLexicalCue>melanisation</mdo:hasLexicalCue>
    <mdo:hasLexicalCue>melanization</mdo:hasLexicalCue>
    <mdo:hasLexicalCue>pigmentation</mdo:hasLexicalCue>
    <mdo:hasLexicalCue>tanning</mdo:hasLexicalCue>
    <mdo:hasGatingWeight>medium</mdo:hasGatingWeight>
    <mdo:hasSemanticRole>postmoult_event</mdo:hasSemanticRole>
    <mdo:requiresContext rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</mdo:requiresContext>
