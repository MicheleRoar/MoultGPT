    <rdfs:comment>Top-level entity for the moulting domain.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://purl.org/moultdb/ontology/Egress">
    <rdfs:label>Egress</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.org/moultdb/ontology/EcdysisEvent"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N72c38295bfa249b5b97344941e7e504d">
        <owl:onProperty rdf:resource="http://purl.org/moultdb/ontology/occursDuringPhase"/>
        <owl:someValuesFrom rdf:resource="http://purl.org/moultdb/ontology/Ecdysis"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Nc075bd65c31d43c087d5069cde197153">
        <owl:onProperty rdf:resource="http://purl.org/moultdb/ontology/involvesStructure"/>
        <owl:someValuesFrom rdf:resource="http://purl.org/moultdb/ontology/Exuvia"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Nb7611365d3e44a2696aa7d185a32f4c9">
        <owl:onProperty rdf:resource="http://purl.org/moultdb/ontology/precedesEvent"/>
        <owl:someValuesFrom rdf:resource="http://purl.org/moultdb/ontology/BodyExpansion"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <mdo:hasLexicalCue>egress</mdo:hasLexicalCue>
    <mdo:hasLexicalCue>emerge</mdo:hasLexicalCue>
    <mdo:hasLexicalCue>exit</mdo:hasLexicalCue>
    <mdo:hasLexicalCue>escape from exuvia</mdo:hasLexicalCue>
    <mdo:hasGatingWeight>strong</mdo:hasGatingWeight>
    <mdo:hasSemanticRole>ecdysis_event</mdo:hasSemanticRole>
    <mdo:requiresContext rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</mdo:requiresContext>
    <rdfs:comment>Exit of the organism from the old cuticle or exuvia during ecdysis.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://purl.org/moultdb/ontology/TraitValue">
    <rdfs:label>TraitValue</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.org/moultdb/ontology/MoultingEntity"/>
    <rdfs:comment>Controlled value for a trait.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://purl.org/moultdb/ontology/Trait">
    <rdfs:label>Trait</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.org/moultdb/ontology/MoultingEntity"/>
    <rdfs:comment>Annotatable character or trait.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://purl.org/moultdb/ontology/MoultingEvent">
    <rdfs:label>MoultingEvent</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.org/moultdb/ontology/MoultingProcess"/>
