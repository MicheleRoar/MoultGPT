# MoultGPT — llm/ environment variables
#
# Copy this file to `.env` (same folder) and fill in the keys for whichever
# providers you actually plan to use (see llm/config/models.py for the
# current model registry). Never commit the real `.env` file.

# --- Remote LLM providers (only set the ones you use) ---

# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Unpaywall (DOI -> open-access PDF lookup) ---
# Unpaywall requires a contact email, not a secret key.
UNPAYWALL_EMAIL=your@email.com

# --- Optional overrides (defaults are fine for local dev) ---
# PORT=5002
# MAX_NEW_TOKENS=512
# TAXONOMY_CSV_PATH=
# TAXONOMY_PICKLE_PATH=
# ONTOLOGY_OWL_PATH=
# GROBID_URL=http://localhost:8070/api/processFulltextDocument
